- title: Diagnostics
  path: diagnostics
  type: sections
  max_columns: 3
  dense_section_placement: false
  sections:
[% for service in model.services %]
  - type: grid
    column_span: 1
    cards:
    - type: heading
      heading: [[ service.label | yaml_scalar ]]
      heading_style: title
      icon: mdi:chip
    - type: tile
      entity: [[ entity_id('sensor', service.name, 'status') ]]
      name: Connection
      icon: mdi:lan-connect
    - type: grid
      columns: 2
      square: false
      cards:
      - type: tile
        entity: [[ entity_id('binary_sensor', service.name, 'service_unhealthy') ]]
        name: Service Health
        icon: mdi:heart-pulse
      - type: tile
        entity: [[ entity_id('input_boolean', service.name, 'service_fault_active') ]]
        name: Confirmed service fault
        icon: mdi:alert-circle-outline
    - type: entities
      title: Latest measurements
      show_header_toggle: false
      entities:
[% for measurement in service.measurements %]
      - entity: [[ entity_id('sensor', service.name, measurement.name) ]]
        name: [[ measurement.label | yaml_scalar ]]
[% endfor %]
[% if service.power is not none %]
    - type: entities
      title: Power Lifecycle
      show_header_toggle: false
      entities:
      - entity: [[ entity_id('input_select', service.name, 'power', 'state') ]]
        name: Power state
      - entity: [[ entity_id('binary_sensor', service.name, 'power', 'mains_present') ]]
        name: External power present
      - entity: [[ entity_id('binary_sensor', service.name, 'power', 'sensor_fault') ]]
        name: Power sensor fault
      - entity: [[ entity_id('input_boolean', service.name, 'power', 'outage_active') ]]
        name: Outage active
      - entity: [[ entity_id('sensor', service.name, 'power', 'last_outage_started') ]]
        name: Last outage started
      - entity: [[ entity_id('sensor', service.name, 'power', 'last_outage_duration') ]]
        name: Last outage duration
[% endif %]
[% endfor %]
