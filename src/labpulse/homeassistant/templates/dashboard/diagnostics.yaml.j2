{# Diagnostics shows readings beside alarm state. Use it to understand why an
   alarm is active or why a reading is unavailable. #}
- title: Diagnostics
  path: diagnostics
  type: sections
  max_columns: 3
  dense_section_placement: false
  sections:
[% for service in model.services %]
{# Keep each service's health and latest readings together. #}
  - type: grid
    column_span: 1
    cards:
    - type: heading
      heading: [[ service.label | yaml_scalar ]]
      heading_style: title
      icon: mdi:chip
    - type: tile
      entity: [[ entity_id('sensor', service.name, 'status') ]]
      name: Connection
      icon: mdi:lan-connect
    - type: grid
      columns: 2
      square: false
      cards:
      - type: tile
        entity: [[ entity_id('sensor', service.name, 'service_health') ]]
        name: Service health
        icon: mdi:heart-pulse
      - type: tile
        entity: [[ entity_id('input_boolean', service.name, 'service_offline_incident_active') ]]
        name: Confirmed offline incident
        icon: mdi:alert-circle-outline
    - type: entities
      title: Service incident details
      show_header_toggle: false
      entities:
      - type: attribute
        entity: [[ entity_id('sensor', service.name, 'service_health') ]]
        attribute: reason
        name: Reason
      - type: attribute
        entity: [[ entity_id('sensor', service.name, 'service_health') ]]
        attribute: condition_age_seconds
        name: Condition age (seconds)
    - type: entities
      title: Latest measurements
      show_header_toggle: false
      entities:
[% for measurement in service.measurements %]
      - entity: [[ measurement.entity_id ]]
        name: [[ measurement.label | yaml_scalar ]]
      - entity: [[ entity_id('sensor', service.name, measurement.name, 'availability') ]]
        name: [[ (measurement.label ~ ' availability') | yaml_scalar ]]
      - type: attribute
        entity: [[ entity_id('sensor', service.name, measurement.name, 'availability') ]]
        attribute: policy
        name: [[ (measurement.label ~ ' policy') | yaml_scalar ]]
      - type: attribute
        entity: [[ entity_id('sensor', service.name, measurement.name, 'availability') ]]
        attribute: condition_age_seconds
        name: [[ (measurement.label ~ ' condition age (seconds)') | yaml_scalar ]]
[% endfor %]
[% if service.power is not none and service.power.alarmed %]
{# These power details are useful for fault finding, but too technical for the
   main Monitor page. #}
    - type: entities
      title: Power Lifecycle
      show_header_toggle: false
      entities:
      - type: simple-entity
        entity: [[ entity_id('input_select', service.name, 'power', 'state') ]]
        name: Power state
        tap_action: {action: none}
        hold_action: {action: none}
        double_tap_action: {action: none}
      - entity: [[ entity_id('binary_sensor', service.name, 'power', 'mains_present') ]]
        name: External power present
      - entity: [[ entity_id('sensor', service.name, 'mains_present', 'availability') ]]
        name: External-power reading availability
      - entity: [[ entity_id('input_boolean', service.name, 'power', 'outage_active') ]]
        name: Outage active
      - entity: [[ entity_id('sensor', service.name, 'power', 'last_outage_started') ]]
        name: Last outage started
      - entity: [[ entity_id('sensor', service.name, 'power', 'last_outage_duration') ]]
        name: Last outage duration
[% endif %]
[% endfor %]
[% if model.outputs %]
  - type: grid
    column_span: 1
    cards:
    - type: heading
      heading: Controlled Outputs
      heading_style: title
      icon: mdi:electric-switch
    - type: entities
      show_header_toggle: false
      entities:
[% for output in model.outputs %]
      - entity: [[ output.entity_id ]]
        name: [[ output.label | yaml_scalar ]]
[% endfor %]
[% endif %]
[% if model.custom_measurements %]
  - type: grid
    column_span: 1
    cards:
    - type: heading
      heading: Calculated Measurements
      heading_style: title
      icon: mdi:calculator-variant-outline
    - type: entities
      title: Latest calculated values
      show_header_toggle: false
      entities:
[% for measurement in model.custom_measurements %]
      - entity: [[ measurement.entity_id ]]
        name: [[ measurement.label | yaml_scalar ]]
      - entity: [[ entity_id('sensor', measurement.service_name, measurement.name, 'availability') ]]
        name: [[ (measurement.label ~ ' availability') | yaml_scalar ]]
      - type: attribute
        entity: [[ entity_id('sensor', measurement.service_name, measurement.name, 'availability') ]]
        attribute: policy
        name: [[ (measurement.label ~ ' policy') | yaml_scalar ]]
      - type: attribute
        entity: [[ entity_id('sensor', measurement.service_name, measurement.name, 'availability') ]]
        attribute: condition_age_seconds
        name: [[ (measurement.label ~ ' condition age (seconds)') | yaml_scalar ]]
[% endfor %]
[% endif %]
