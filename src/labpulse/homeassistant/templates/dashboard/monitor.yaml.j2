{# Monitor is the page used for quick checks. Show each setup
   in the order used in config.yaml. #}
- title: Monitor
  path: monitor
  cards:
[% if not model.monitor_setups %]
{# Keep global status on the main tab even when every setup has moved to custom
   dashboards or no measurements have been configured yet. #}
  - type: vertical-stack
    cards:
[% include "dashboard/monitor_status.yaml.j2" %]
[% endif %]
[% for setup in model.monitor_setups %]
  - type: vertical-stack
    cards:
[% if loop.first %]
[% include "dashboard/monitor_status.yaml.j2" %]
[% endif %]
[% include "dashboard/setup_measurements.yaml.j2" %]
[% endfor %]
[% if model.unassigned_outputs %]
  - type: vertical-stack
    cards:
    - type: heading
      heading: Controlled Outputs
      heading_style: title
      icon: mdi:electric-switch
    - type: entities
      show_header_toggle: false
      entities:
[% for output in model.unassigned_outputs %]
      - entity: [[ output.entity_id ]]
        name: [[ output.label | yaml_scalar ]]
        icon: [[ output.icon ]]
[% endfor %]
[% endif %]
