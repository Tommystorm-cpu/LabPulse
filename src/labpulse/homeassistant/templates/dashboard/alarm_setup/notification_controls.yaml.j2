  - type: grid
    column_span: 1
    cards:
    - type: heading
      heading: Notification Controls
      heading_style: title
      icon: mdi:message-cog
    - type: entities
      show_header_toggle: false
      entities:
      - entity: input_boolean.labpulse_global_notifications_muted
        name: Mute all notifications
      - entity: input_boolean.labpulse_notification_test_mode
        name: Test mode
    - type: tile
      entity: script.labpulse_send_phone_book_notification
      name: Send phone book notification
      icon: mdi:account-multiple-check
      hide_state: true
      grid_options: {columns: full}
      tap_action:
        action: perform-action
        perform_action: script.labpulse_send_phone_book_notification
        confirmation:
          text: >-
            Send the phone book notification to the active recipient list? Test mode uses only test recipients; live mode uses normal recipients. Nothing is sent while all notifications are muted.
