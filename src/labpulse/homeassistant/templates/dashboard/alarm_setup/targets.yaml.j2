{# Target tiles link to the detailed setup or power subview. Setup mute state is
   shown here because it affects every alarm belonging to that lab area. #}
[% if model.setups or power_services %]
  - type: grid
    column_span: 3
    cards:
    - type: heading
      heading: Configure Alarms
      heading_style: title
      icon: mdi:tune-variant
[% for setup in model.setups %]
{# Show either Mute or Unmute in the same place. The button always says what it
   will do when pressed. #}
    - type: grid
      columns: 3
      square: false
      grid_options: {columns: full}
      cards:
      - type: tile
        entity: [[ setup.muted_entity ]]
        name: [[ (setup.label ~ ' — ' ~ setup.measurement_count ~ ' measurements') | yaml_scalar ]]
        icon: [[ setup.icon ]]
        grid_options: {columns: 4}
        tap_action: {action: none}
        hold_action: {action: none}
        double_tap_action: {action: none}
        icon_tap_action: {action: none}
        hide_state: true
      - type: vertical-stack
        cards:
        - type: conditional
          conditions:
          - entity: [[ setup.muted_entity ]]
            state: 'off'
          grid_options: {columns: full}
          card:
            type: tile
            entity: [[ setup.muted_entity ]]
            name: Mute notifications
            icon: mdi:bell-off-outline
            hide_state: true
            tap_action:
              action: perform-action
              perform_action: input_boolean.turn_on
              target: {entity_id: [[ setup.muted_entity ]]}
[% if setup.shared_measurement_labels %]
{# A sensor shared with another setup may still send messages after this setup
   is muted. Warn the user before applying the mute. #}
              confirmation:
                text: [[ setup.shared_measurement_warning | yaml_scalar ]]
[% endif %]
        - type: conditional
          conditions:
          - entity: [[ setup.muted_entity ]]
            state: 'on'
          grid_options: {columns: full}
          card:
            type: tile
            entity: [[ setup.muted_entity ]]
            name: Unmute notifications
            icon: mdi:bell-outline
            hide_state: true
            tap_action:
              action: perform-action
              perform_action: input_boolean.turn_off
              target: {entity_id: [[ setup.muted_entity ]]}
      - type: tile
        entity: [[ setup.muted_entity ]]
        name: Configure
        icon: mdi:tune-variant
        hide_state: true
        tap_action:
          action: navigate
          navigation_path: /labpulse-monitor/alarm-setup-[[ setup.setup_id ]]
        icon_tap_action:
          action: navigate
          navigation_path: /labpulse-monitor/alarm-setup-[[ setup.setup_id ]]
[% endfor %]
[% for service in power_services %]
{# Power covers the whole installation, so its mute control is not placed under
   one lab setup. #}
    - type: tile
      entity: [[ entity_id('input_select', service.name, 'power', 'state') ]]
      name: Power Monitoring
      icon: mdi:battery-charging
      hide_state: true
      tap_action:
        action: navigate
        navigation_path: /labpulse-monitor/alarm-power-[[ service.service_id ]]
      icon_tap_action:
        action: navigate
        navigation_path: /labpulse-monitor/alarm-power-[[ service.service_id ]]
[% endfor %]
[% endif %]
