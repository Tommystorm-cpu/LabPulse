{# Global controls and confirmed incidents appear before ordinary readings. #}
    - type: conditional
      conditions:
      - condition: state
        entity: input_boolean.labpulse_global_notifications_muted
        state: 'on'
      card:
        type: markdown
        content: |-
          ## Global Mute Applied

          Conditions remain visible, but LabPulse notifications are disabled.

          [Review notification controls](/labpulse-monitor/alarm-setup)
    - type: conditional
      conditions:
      - condition: state
        entity: input_boolean.labpulse_notification_test_mode
        state: 'on'
      card:
        type: markdown
        content: |-
          ## Test Mode Applied

          Notifications are routed only to the configured test recipients.

          [Review notification controls](/labpulse-monitor/alarm-setup)
    - type: entity-filter
      entities:
[% for service in model.services %]
      - type: simple-entity
        entity: [[ entity_id('input_boolean', service.name, 'service_offline_incident_active') ]]
        name: [[ (service.label ~ ': service offline') | yaml_scalar ]]
        icon: mdi:lan-disconnect
        tap_action:
          action: navigate
          navigation_path: /labpulse-monitor/system-status
        hold_action: {action: none}
        double_tap_action: {action: none}
        conditions:
        - condition: state
          state: 'on'
[% endfor %]
[% for service, measurement in model.measurements %]
[% if measurement.required %]
      - type: simple-entity
        entity: [[ entity_id('input_boolean', service.name, measurement.name, 'missing_reading_incident_active') ]]
        name: [[ (measurement.label ~ ': no recent data') | yaml_scalar ]]
        icon: mdi:alert-outline
        tap_action:
          action: navigate
[% if measurement.setup_ids %]
          navigation_path: /labpulse-monitor/alarm-setup-[[ measurement.setup_ids[0] ]]
[% elif service.power is defined and service.power is not none %]
          navigation_path: /labpulse-monitor/alarm-power-[[ service.service_id ]]
[% else %]
          navigation_path: /labpulse-monitor/system-status
[% endif %]
        hold_action: {action: none}
        double_tap_action: {action: none}
        conditions:
        - condition: state
          state: 'on'
        - condition: state
          entity: [[ measurement.reading_notification_mute_entity ]]
          state: 'off'
[% if measurement.setup_ids %]
        - condition: or
          conditions:
[% for setup_id in measurement.setup_ids %]
          - condition: state
            entity: [[ entity_id('input_boolean', 'setup', setup_id, 'notifications_muted') ]]
            state: 'off'
[% endfor %]
[% endif %]
[% endif %]
[% endfor %]
[% for service, measurement in model.alarm_measurements %]
      - type: simple-entity
        entity: [[ entity_id('input_select', service.name, measurement.name, 'alarm_state') ]]
        name: [[ (measurement.label ~ ': alarm state') | yaml_scalar ]]
        icon: mdi:alarm-light-outline
        tap_action:
          action: navigate
          navigation_path: /labpulse-monitor/alarm-setup-[[ measurement.setup_ids[0] ]]
        hold_action: {action: none}
        double_tap_action: {action: none}
        conditions:
        - condition: state
          state: Danger
        - condition: state
          entity: [[ measurement.reading_notification_mute_entity ]]
          state: 'off'
        - condition: state
          entity: [[ entity_id('binary_sensor', service.name, measurement.name, 'reading_available') ]]
          state: 'on'
        - condition: or
          conditions:
[% for setup_id in measurement.setup_ids %]
          - condition: state
            entity: [[ entity_id('input_boolean', 'setup', setup_id, 'notifications_muted') ]]
            state: 'off'
[% endfor %]
[% endfor %]
[% for service in model.power_alarm_services %]
      - type: simple-entity
        entity: [[ entity_id('input_select', service.name, 'power', 'state') ]]
        name: 'Power supply needs attention'
        icon: mdi:power-plug-off-outline
        tap_action:
          action: navigate
          navigation_path: /labpulse-monitor/alarm-power-[[ service.service_id ]]
        hold_action: {action: none}
        double_tap_action: {action: none}
        conditions:
        - condition: state
          state: Running on battery
        - condition: state
          entity: [[ entity_id('input_boolean', service.name, 'power', 'muted') ]]
          state: 'off'
[% endfor %]
      conditions:
      - condition: or
        conditions:
        - condition: state
          state: 'on'
        - condition: state
          state: Danger
        - condition: state
          state: Running on battery
      show_empty: false
      card:
        type: entities
        title: Current Problems
        show_header_toggle: false
