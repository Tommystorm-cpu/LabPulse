{# Use separate phone and desktop layouts. Home Assistant shows the one that
   matches the current screen width. #}
[% for mobile in (false, true) %]
[% set width = 'full' if mobile else 12 %]
  - type: grid
    column_span: 3
    visibility:
    - condition: screen
      media_query: [[ ('(max-width: 899px)' if mobile else '(min-width: 900px)') | yaml_scalar ]]
    cards:
    - type: heading
      heading: [[ setup.label | yaml_scalar ]]
      heading_style: title
      icon: [[ setup.icon ]]
      grid_options: {columns: [[ width ]]}
[% for muted, name, icon in (
  (false, 'Notifications active', 'mdi:bell-ring-outline'),
  (true, 'Notifications muted', 'mdi:bell-off-outline')
) %]
{# Show either Mute or Unmute. The visible button always names its next action. #}
    - type: conditional
      conditions:
      - entity: [[ setup.muted_entity ]]
        state: [[ ('on' if muted else 'off') | yaml_scalar ]]
      grid_options: {columns: [[ width ]]}
      card:
        type: tile
        entity: [[ setup.muted_entity ]]
        name: [[ name | yaml_scalar ]]
        icon: [[ icon ]]
        hide_state: true
        tap_action: {action: none}
        hold_action: {action: none}
        double_tap_action: {action: none}
        icon_tap_action: {action: none}
[% endfor %]
    - type: conditional
      conditions:
      - entity: [[ setup.muted_entity ]]
        state: 'off'
      grid_options: {columns: [[ width ]]}
      card:
        type: tile
        entity: [[ setup.muted_entity ]]
        name: Mute notifications
        icon: mdi:bell-off-outline
        hide_state: true
        tap_action:
          action: perform-action
          perform_action: input_boolean.turn_on
          target: {entity_id: [[ setup.muted_entity ]]}
[% if setup.shared_measurement_labels %]
{# Keep this warning at the action point. A general note elsewhere is too easy
   to miss when muting a setup during an incident. #}
          confirmation:
            text: [[ setup.shared_measurement_warning | yaml_scalar ]]
[% endif %]
    - type: conditional
      conditions:
      - entity: [[ setup.muted_entity ]]
        state: 'on'
      grid_options: {columns: [[ width ]]}
      card:
        type: tile
        entity: [[ setup.muted_entity ]]
        name: Unmute notifications
        icon: mdi:bell-outline
        hide_state: true
        tap_action:
          action: perform-action
          perform_action: input_boolean.turn_off
          target: {entity_id: [[ setup.muted_entity ]]}
[% endfor %]
