{# Voltage, battery level, and mains presence describe one power event. Treating
   them as three separate alarms would produce confusing messages. #}
[% for service in model.power_alarm_services %]
[% set power = service.power %]
[% include "automations/power_state.yaml.j2" %]
[% include "automations/power_sensor_health.yaml.j2" %]
[% include "automations/power_reconciliation.yaml.j2" %]
[% endfor %]
