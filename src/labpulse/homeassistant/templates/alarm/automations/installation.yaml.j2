{# Copy the default settings into Home Assistant on the first install only.
   Later regeneration must keep the user's saved choices. #}
  - alias: LabPulse Initialize First Installation
    mode: single
    trigger:
    - platform: homeassistant
      event: start
    - platform: event
      event_type: automation_reloaded
    condition:
    - condition: state
      entity_id: input_boolean.labpulse_first_install_initialized
      state: 'off'
    action:
    - service: input_boolean.turn_on
      target:
        entity_id:
        - [[ 'input_boolean.labpulse_global_notifications_muted' | yaml_scalar ]]
        - input_boolean.labpulse_first_install_initialized
{# The update command publishes this retained flag before containers restart.
   Keeping it in a helper makes the suppression state survive Home Assistant's
   own restart and keeps ordinary first installations unmuted. #}
  - alias: LabPulse Synchronize Update Maintenance
    mode: restart
    trigger:
    - platform: mqtt
      topic: [[ model.update_maintenance_topic | yaml_scalar ]]
    action:
    - condition: template
      value_template: >-
        {{ trigger.payload_json is mapping
           and trigger.payload_json.request_id | default('') | length > 0
           and trigger.payload_json.state in ['ON', 'OFF'] }}
    - choose:
      - conditions: "{{ trigger.payload_json.state == 'ON' }}"
        sequence:
        - service: input_boolean.turn_on
          target:
            entity_id: input_boolean.labpulse_update_maintenance
      default:
      - service: input_datetime.set_datetime
        target:
          entity_id: input_datetime.labpulse_update_maintenance_cleared
        data:
          timestamp: "{{ as_timestamp(now()) }}"
      - service: input_boolean.turn_off
        target:
          entity_id: input_boolean.labpulse_update_maintenance
    - service: mqtt.publish
      data:
        topic: [[ model.update_maintenance_ack_topic | yaml_scalar ]]
        qos: 1
        retain: true
        payload: "{{ trigger.payload }}"
{# A fresh broker has no retained request for the defensive SMS subscriber to
   consume. Publish the restored helper state after startup: normally OFF, but
   still ON after a failed update. The synchronizer above then acknowledges the
   new request like any other state transition. #}
  - alias: LabPulse Publish Restored Update Maintenance State
    mode: single
    trigger:
    - platform: homeassistant
      event: start
    action:
    - delay:
        seconds: 5
    - service: mqtt.publish
      data:
        topic: [[ model.update_maintenance_topic | yaml_scalar ]]
        qos: 1
        retain: true
        payload: >-
          {{ {
            "request_id": "homeassistant-startup-" ~ now().strftime('%Y%m%dT%H%M%S%f'),
            "state": "ON" if is_state('input_boolean.labpulse_update_maintenance', 'on') else "OFF"
          } | to_json }}
[% if model.bulk_alarm_targets %]
{# A new target has different valid deadbands, so discard field selections
   before the user reviews and applies values to it. #}
  - id: labpulse_clear_bulk_alarm_selection_on_target_change
    alias: LabPulse Clear Bulk Alarm Selection On Target Change
    mode: restart
    trigger:
      - platform: state
        entity_id: [[ 'input_select.labpulse_bulk_alarm_timing_target' | yaml_scalar ]]
    action:
      - service: [[ 'script.labpulse_clear_bulk_alarm_selection' | yaml_scalar ]]
[% endif %]
