  - alias: LabPulse Initialize First Installation
    mode: single
    trigger:
    - platform: homeassistant
      event: start
    - platform: event
      event_type: automation_reloaded
    condition:
    - condition: state
      entity_id: input_boolean.labpulse_first_install_initialized
      state: 'off'
    action:
    - service: input_boolean.turn_on
      target:
        entity_id:
        - [[ 'input_boolean.labpulse_global_notifications_muted' | yaml_scalar ]]
        - input_boolean.labpulse_first_install_initialized
[% if model.bulk_alarm_targets %]
  - id: labpulse_clear_bulk_alarm_selection_on_target_change
    alias: LabPulse Clear Bulk Alarm Selection On Target Change
    mode: restart
    trigger:
      - platform: state
        entity_id: [[ 'input_select.labpulse_bulk_alarm_timing_target' | yaml_scalar ]]
    action:
      - service: [[ 'script.labpulse_clear_bulk_alarm_selection' | yaml_scalar ]]
[% endif %]
