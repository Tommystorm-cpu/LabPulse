  - id: labpulse_[[ service.service_id ]]_power_reconcile
    alias: LabPulse [[ service.label ]] Power Reconcile
    mode: restart
    trigger:
    - platform: homeassistant
      event: start
    - platform: event
      event_type: automation_reloaded
    action:
    - delay:
        seconds: 1
    - choose:
      - conditions: >-
          {{ is_state('[[ entity_id('binary_sensor', service.name, 'power', 'sensor_fault') ]]', 'on') and is_state('[[ entity_id('input_boolean', service.name, 'power', 'sensor_fault_confirmed') ]]', 'on') }}
        sequence:
        - service: input_select.select_option
          target:
            entity_id: [[ entity_id('input_select', service.name, 'power', 'state') | yaml_scalar ]]
          data:
            option: Sensor Fault
      - conditions: >-
          {{ is_state('[[ entity_id('input_boolean', service.name, 'power', 'outage_active') ]]', 'on') and is_state('[[ entity_id('binary_sensor', service.name, 'power', 'mains_present') ]]', 'off') }}
        sequence:
        - service: input_select.select_option
          target:
            entity_id: [[ entity_id('input_select', service.name, 'power', 'state') | yaml_scalar ]]
          data:
            option: On Battery
      - conditions: >-
          {{ is_state('[[ entity_id('input_boolean', service.name, 'power', 'outage_active') ]]', 'off') and is_state('[[ entity_id('binary_sensor', service.name, 'power', 'mains_present') ]]', 'on') }}
        sequence:
        - service: input_select.select_option
          target:
            entity_id: [[ entity_id('input_select', service.name, 'power', 'state') | yaml_scalar ]]
          data:
            option: Normal
  - id: labpulse_[[ service.service_id ]]_power_reconcile_outage
    alias: LabPulse [[ service.label ]] Reconcile Missed Outage
    mode: restart
    trigger:
    - platform: homeassistant
      event: start
    - platform: event
      event_type: automation_reloaded
    action:
    - delay:
        seconds: [[ power.config.outage_confirm_seconds | yaml_scalar ]]
    - condition: state
      entity_id: [[ entity_id('binary_sensor', service.name, 'power', 'mains_present') | yaml_scalar ]]
      state: 'off'
    - condition: state
      entity_id: [[ entity_id('input_boolean', service.name, 'power', 'outage_active') | yaml_scalar ]]
      state: 'off'
    - condition: state
      entity_id: [[ entity_id('binary_sensor', service.name, 'power', 'sensor_fault') | yaml_scalar ]]
      state: 'off'
    - service: input_datetime.set_datetime
      target:
        entity_id: [[ entity_id('input_datetime', service.name, 'power', 'outage_started') | yaml_scalar ]]
      data:
        timestamp: >-
          {{ as_timestamp(now()) - [[ power.config.outage_confirm_seconds ]] }}
    - service: input_boolean.turn_on
      target:
        entity_id: [[ entity_id('input_boolean', service.name, 'power', 'outage_active') | yaml_scalar ]]
    - service: input_select.select_option
      target:
        entity_id: [[ entity_id('input_select', service.name, 'power', 'state') | yaml_scalar ]]
      data:
        option: On Battery
    - choose:
      - conditions:
        - condition: state
          entity_id: [[ entity_id('input_boolean', service.name, 'power', 'muted') | yaml_scalar ]]
          state: 'off'
        - condition: state
          entity_id: [[ 'input_boolean.labpulse_global_notifications_muted' | yaml_scalar ]]
          state: 'off'
        sequence:
        - service: mqtt.publish
          data:
            topic: [[ model.sms_send_topic | yaml_scalar ]]
            qos: 1
            retain: false
            payload: >
              {{ {"request_id": "labpulse_[[ service.service_id ]]_power_warning_reconcile_" ~ now().strftime('%Y%m%dT%H%M%S%f'), "event": "warning", "service": "[[ service.name ]]", "service_label": "[[ service.label ]]", "measurement": "power", "measurement_label": "External power", "state": "On Battery", "title": [[ sms.alerts.power_warning.title | render_fragment(service=service, power=power, model=model) ]], "message": ([[ sms.alerts.power_warning.message | render_fragment(service=service, power=power, model=model) ]]) ~ "\n[[ power.mains_present.notification_context ]]", "test_mode": is_state('[[ 'input_boolean.labpulse_notification_test_mode' ]]', 'on'), "current_measurement": states('[[ entity_id('sensor', service.name, 'voltage') ]]')} | to_json }}
  - id: labpulse_[[ service.service_id ]]_power_reconcile_recovery
    alias: LabPulse [[ service.label ]] Reconcile Missed Recovery
    mode: restart
    trigger:
    - platform: homeassistant
      event: start
    - platform: event
      event_type: automation_reloaded
    action:
    - delay:
        seconds: [[ power.config.restore_confirm_seconds | yaml_scalar ]]
    - condition: state
      entity_id: [[ entity_id('binary_sensor', service.name, 'power', 'mains_present') | yaml_scalar ]]
      state: 'on'
    - condition: state
      entity_id: [[ entity_id('input_boolean', service.name, 'power', 'outage_active') | yaml_scalar ]]
      state: 'on'
    - condition: state
      entity_id: [[ entity_id('binary_sensor', service.name, 'power', 'sensor_fault') | yaml_scalar ]]
      state: 'off'
    - variables:
        outage_start: >-
          {{ as_timestamp(states('[[ entity_id('input_datetime', service.name, 'power', 'outage_started') ]]'), as_timestamp(now())) }}
        outage_duration: >-
          {{ [0, as_timestamp(now()) - outage_start] | max | round(0) }}
    - service: input_datetime.set_datetime
      target:
        entity_id: [[ entity_id('input_datetime', service.name, 'power', 'last_outage_started') | yaml_scalar ]]
      data:
        timestamp: >-
          {{ outage_start }}
    - service: input_number.set_value
      target:
        entity_id: [[ entity_id('input_number', service.name, 'power', 'last_outage_duration') | yaml_scalar ]]
      data:
        value: >-
          {{ outage_duration }}
    - service: input_boolean.turn_off
      target:
        entity_id: [[ entity_id('input_boolean', service.name, 'power', 'outage_active') | yaml_scalar ]]
    - service: input_select.select_option
      target:
        entity_id: [[ entity_id('input_select', service.name, 'power', 'state') | yaml_scalar ]]
      data:
        option: Normal
    - choose:
      - conditions:
        - condition: state
          entity_id: [[ entity_id('input_boolean', service.name, 'power', 'muted') | yaml_scalar ]]
          state: 'off'
        - condition: state
          entity_id: [[ 'input_boolean.labpulse_global_notifications_muted' | yaml_scalar ]]
          state: 'off'
        sequence:
        - service: mqtt.publish
          data:
            topic: [[ model.sms_send_topic | yaml_scalar ]]
            qos: 1
            retain: false
            payload: >
              {{ {"request_id": "labpulse_[[ service.service_id ]]_power_recovery_reconcile_" ~ now().strftime('%Y%m%dT%H%M%S%f'), "event": "recovery", "service": "[[ service.name ]]", "service_label": "[[ service.label ]]", "measurement": "power", "measurement_label": "External power", "state": "Normal", "title": [[ sms.alerts.power_recovery.title | render_fragment(service=service, power=power, model=model) ]], "message": ([[ sms.alerts.power_recovery.message | render_fragment(service=service, power=power, model=model) ]]) ~ "\n[[ power.mains_present.notification_context ]]", "test_mode": is_state('[[ 'input_boolean.labpulse_notification_test_mode' ]]', 'on'), "current_measurement": states('[[ entity_id('sensor', service.name, 'voltage') ]]')} | to_json }}
