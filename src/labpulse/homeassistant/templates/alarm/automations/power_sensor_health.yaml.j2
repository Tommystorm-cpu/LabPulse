  - id: labpulse_[[ service.service_id ]]_power_sensor_fault
    alias: LabPulse [[ service.label ]] Power Sensor Fault
    mode: restart
    trigger:
    - platform: state
      entity_id: [[ entity_id('binary_sensor', service.name, 'power', 'sensor_fault') | yaml_scalar ]]
      to: 'on'
    - platform: homeassistant
      event: start
    - platform: event
      event_type: automation_reloaded
    action:
    - delay:
        seconds: 2
    - condition: state
      entity_id: [[ entity_id('binary_sensor', service.name, 'power', 'sensor_fault') | yaml_scalar ]]
      state: 'on'
    - condition: state
      entity_id: [[ entity_id('input_boolean', service.name, 'power', 'sensor_fault_confirmed') | yaml_scalar ]]
      state: 'off'
    - service: input_boolean.turn_on
      target:
        entity_id: [[ entity_id('input_boolean', service.name, 'power', 'sensor_fault_confirmed') | yaml_scalar ]]
    - service: input_select.select_option
      target:
        entity_id: [[ entity_id('input_select', service.name, 'power', 'state') | yaml_scalar ]]
      data:
        option: Sensor Fault
    - choose:
      - conditions:
        - condition: state
          entity_id: [[ entity_id('input_boolean', service.name, 'power', 'muted') | yaml_scalar ]]
          state: 'off'
        - condition: state
          entity_id: [[ 'input_boolean.labpulse_global_notifications_muted' | yaml_scalar ]]
          state: 'off'
        sequence:
        - service: persistent_notification.create
          data:
            title: >
              {{ ('[TEST] ' if is_state('[[ 'input_boolean.labpulse_notification_test_mode' ]]', 'on') else '') ~ 'LabPulse external-power sensor fault' }}
            message: >
              [[ service.label ]] cannot read the X1200 external-power signal. Raw mains state: {{ states('[[ entity_id('sensor', service.name, 'mains_present') ]]') }}. Service status: {{ states('[[ entity_id('sensor', service.name, 'status') ]]') }}. This is not being treated as an outage. [[ power.mains_present.notification_context ]]
            notification_id: labpulse_[[ service.service_id ]]_power
        - service: mqtt.publish
          data:
            topic: [[ model.sms_send_topic | yaml_scalar ]]
            qos: 1
            retain: false
            payload: >
              {{ {"request_id": "labpulse_[[ service.service_id ]]_power_sensor_fault_" ~ now().strftime('%Y%m%dT%H%M%S%f'), "event": "sensor_fault", "service": "[[ service.name ]]", "service_label": "[[ service.label ]]", "measurement": "power", "measurement_label": "External-power GPIO", "state": "Sensor Fault", "title": [[ sms.alerts.power_sensor_fault.title | render_fragment(service=service, power=power, model=model) ]], "message": ([[ sms.alerts.power_sensor_fault.message | render_fragment(service=service, power=power, model=model) ]]) ~ "\n[[ power.mains_present.notification_context ]]", "test_mode": is_state('[[ 'input_boolean.labpulse_notification_test_mode' ]]', 'on'), "current_measurement": states('[[ entity_id('sensor', service.name, 'mains_present') ]]')} | to_json }}
  - id: labpulse_[[ service.service_id ]]_power_sensor_recovery
    alias: LabPulse [[ service.label ]] Power Sensor Recovery
    mode: single
    trigger:
    - platform: state
      entity_id: [[ entity_id('binary_sensor', service.name, 'power', 'sensor_fault') | yaml_scalar ]]
      from: 'on'
      to: 'off'
    condition:
    - condition: state
      entity_id: [[ entity_id('input_boolean', service.name, 'power', 'sensor_fault_confirmed') | yaml_scalar ]]
      state: 'on'
    action:
    - service: input_boolean.turn_off
      target:
        entity_id: [[ entity_id('input_boolean', service.name, 'power', 'sensor_fault_confirmed') | yaml_scalar ]]
    - choose:
      - conditions: >-
          {{ is_state('[[ entity_id('input_boolean', service.name, 'power', 'outage_active') ]]', 'on') }}
        sequence:
        - service: input_select.select_option
          target:
            entity_id: [[ entity_id('input_select', service.name, 'power', 'state') | yaml_scalar ]]
          data:
            option: On Battery
      default:
      - service: input_select.select_option
        target:
          entity_id: [[ entity_id('input_select', service.name, 'power', 'state') | yaml_scalar ]]
        data:
          option: Normal
    - choose:
      - conditions:
        - condition: state
          entity_id: [[ entity_id('input_boolean', service.name, 'power', 'muted') | yaml_scalar ]]
          state: 'off'
        - condition: state
          entity_id: [[ 'input_boolean.labpulse_global_notifications_muted' | yaml_scalar ]]
          state: 'off'
        sequence:
        - service: persistent_notification.create
          data:
            title: >
              {{ ('[TEST] ' if is_state('[[ 'input_boolean.labpulse_notification_test_mode' ]]', 'on') else '') ~ 'LabPulse external-power sensor restored' }}
            message: >
              [[ service.label ]] can read the X1200 external-power signal again. Current mains state: {{ states('[[ entity_id('sensor', service.name, 'mains_present') ]]') }}. Service status: {{ states('[[ entity_id('sensor', service.name, 'status') ]]') }}. [[ power.mains_present.notification_context ]]
            notification_id: labpulse_[[ service.service_id ]]_power
        - service: mqtt.publish
          data:
            topic: [[ model.sms_send_topic | yaml_scalar ]]
            qos: 1
            retain: false
            payload: >
              {{ {"request_id": "labpulse_[[ service.service_id ]]_power_sensor_recovery_" ~ now().strftime('%Y%m%dT%H%M%S%f'), "event": "recovery", "service": "[[ service.name ]]", "service_label": "[[ service.label ]]", "measurement": "power", "measurement_label": "External-power GPIO", "state": states('[[ entity_id('input_select', service.name, 'power', 'state') ]]'), "title": [[ sms.alerts.power_sensor_recovery.title | render_fragment(service=service, power=power, model=model) ]], "message": ([[ sms.alerts.power_sensor_recovery.message | render_fragment(service=service, power=power, model=model) ]]) ~ "\n[[ power.mains_present.notification_context ]]", "test_mode": is_state('[[ 'input_boolean.labpulse_notification_test_mode' ]]', 'on'), "current_measurement": states('[[ entity_id('sensor', service.name, 'mains_present') ]]')} | to_json }}
